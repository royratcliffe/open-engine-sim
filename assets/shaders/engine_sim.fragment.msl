#include <metal_stdlib>
#include <simd/simd.h>

using namespace metal;

struct type_VertexUniforms
{
    float4x4 transform;
    float4x4 cameraView;
    float4x4 projection;
};

struct type_FragmentUniforms
{
    float4 baseColor;
};

struct PSMain_out
{
    float4 out_var_SV_Target0 [[color(0)]];
};

fragment PSMain_out PSMain(constant type_FragmentUniforms& FragmentUniforms [[buffer(0)]])
{
    PSMain_out out = {};
    out.out_var_SV_Target0 = FragmentUniforms.baseColor;
    return out;
}

